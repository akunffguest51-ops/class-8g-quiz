# Salin file ini menjadi .env.local untuk pengembangan lokal (vercel dev).
# Di Vercel, nilai-nilai ini diisi lewat Project Settings > Environment Variables,
# BUKAN lewat file ini.

# Diambil dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Dashboard > Project Settings > API > "service_role" secret key
# JANGAN PERNAH mengekspos key ini ke frontend / commit ke git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bebas ditentukan sendiri — password untuk masuk ke /admin
ADMIN_KEY=ganti-dengan-password-rahasia
